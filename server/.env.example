# Server
NODE_ENV=development
PORT=5000

# MongoDB
# Local:   mongodb://127.0.0.1:27017/is-audit
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/is-audit
MONGO_URI=mongodb://127.0.0.1:27017/is-audit

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - the origin(s) your Vite frontend runs on
CLIENT_ORIGIN=http://localhost:5173

# Default admin created by the seed script
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# AI-powered report narratives (Summary Report page). Generated locally by
# server/scripts/generate_narrative.py — requires python3 on PATH. Optional
# override if your python binary is named differently:
# PYTHON_BIN=python3
